generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT
  EMPLOYER
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  SELECTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  applicantProfile  ApplicantProfile?
  employerProfile   EmployerProfile?
  applications      Application[]
}

model ApplicantProfile {
  id            String @id @default(uuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])
  qualification String // OND, HND, BSC, MSC
  skills        String[] 
  experienceYrs Int    @default(0)
  cvUrl         String?
}

model EmployerProfile {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  organisation String
}

model Vacancy {
  id               String   @id @default(uuid())
  employerId       String
  title            String
  companyName      String
  location         String
  workMode         String  
  salary           String
  type             String
  description      String
  status           String   @default("DRAFT")
  deadline         DateTime
  minQualification String
  requiredSkills   String[]
  requiredYears    Int
  weights          Json     
  createdAt        DateTime @default(now())

  applications Application[]
}

model Application {
  id          String            @id @default(uuid())
  vacancyId   String
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id])
  applicantId String
  applicant   User              @relation(fields: [applicantId], references: [id])
  status      ApplicationStatus @default(SUBMITTED)
  totalScore  Float?
  createdAt   DateTime          @default(now())

  @@unique([vacancyId, applicantId]) 
}

model Internship {
  id          String   @id @default(uuid())
  employerId  String
  title       String
  companyName  String
  description String
  location    String
  duration    String
  deadline    DateTime
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())

  applications InternshipApplication[]
}

model InternshipApplication {
  id           String   @id @default(uuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id])
  applicantId  String
  status       String   @default("SUBMITTED")
  createdAt    DateTime @default(now())

  @@unique([internshipId, applicantId])
}

model Interview {
  id            String   @id @default(uuid())
  applicationId String   @unique
  date          DateTime
  time          String
  mode          String   // Virtual or In-person
  link          String?  // Zoom/Meet link or physical address
  notes         String?
  createdAt     DateTime @default(now())
}